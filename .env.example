# Copie para .env e altere as chaves. O ficheiro .env não vai para o Git.

# Modo de dados: "simulacao" (Blocos 17 e 32) ou "volve" (replay de dados reais)
MODO_DADOS=simulacao
# Nome do ficheiro de produção do Volve dentro da pasta ./data (só no modo volve)
VOLVE_NOME_FICHEIRO=volve_producao.csv

# Chaves de API: use valores longos e aleatórios, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_INGESTAO=troque-esta-chave-de-ingestao
API_KEY_CONTROLO=troque-esta-chave-de-controlo

# Limites operacionais (bar) e preço de referência
LIMITE_ATENCAO_BAR=135
LIMITE_CRITICO_BAR=150
PRECO_BARRIL_USD=80

# Intervalo entre leituras do campo (segundos)
INTERVALO_S=3
